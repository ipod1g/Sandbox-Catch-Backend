{
  "name": "sandbox-catch-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "introspect": "drizzle-kit introspect",
    "generate": "drizzle-kit generate",
    "migrate": "tsx -r dotenv/config scripts/migrate.ts",
    "seed": "tsx -r dotenv/config scripts/seed.ts",
    "ts-check": "tsc --project tsconfig.json",
    "build": "rimraf dist && tsc",
    "add-build": "git add dist"
  },
  "pre-commit": [
    "ts-check",
    "build",
    "add-build"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.9",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "postgres": "^3.4.9",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "pre-commit": "^2.0.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
